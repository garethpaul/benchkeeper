{
  "name": "repair-desk-provisional",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "runtime": "wrangler dev --local --ip 127.0.0.1 --inspector-ip 127.0.0.1 --port 8787 --show-interactive-dev-session=false",
    "bundle:check": "wrangler deploy --dry-run --outdir work/worker-bundle",
    "test:runtime": "node scripts/smoke-runtime.mjs",
    "verify:local": "node scripts/verify-local.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@fontsource/dm-serif-display": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "csv-parse": "7.0.2",
    "lucide-react": "^1.39.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.128.0"
  }
}
